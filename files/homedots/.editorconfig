; https://editorconfig.org/

root = true

[*]
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 88
end_of_line = lf
charset = utf-8

[*.{py,rst,txt}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 2

[*.{go,mod}]
indent_style = tab
indent_size = 4

[*.rs]
indent_style = space
max_line_length = 100

[*.md]
indent_style = space
indent_size = 2
max_line_length = 78
trim_trailing_whitespace = false
eclint_indent_style = unset

[*.{yml,js,jsm,mjs,json,xml,html,css,less,sass}]
indent_style = space
indent_size = 2

[tests/**]
trim_trailing_whitespace = false

[tests/**.{rs,js,py}]
trim_trailing_whitespace = true

[COMMIT_EDITMSG]
max_line_length = off
