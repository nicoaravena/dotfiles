// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "close_panel_on_toggle": true,
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 1.0
  },
  "window_decorations": "server",
  "use_system_window_tabs": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": true
  },
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "status_bar": {
    "show_active_file": true
  },
  "autosave": "on_focus_change",
  "base_keymap": "Zed",
  "vim_mode": false,
  "ui_font_weight": 400.0,
  "ui_font_family": "Noto Sans",
  "buffer_line_height": "standard",
  "auto_update": false,
  "diff_view_style": "unified",
  "helix_mode": false,
  "show_wrap_guides": true,
  "text_rendering_mode": "platform_default",
  "colorize_brackets": true,
  "code_lens": "menu",
  "completion_menu_scrollbar": "always",
  "indent_guides": {
    "background_coloring": "disabled",
    "active_line_width": 3,
    "line_width": 2,
    "coloring": "indent_aware",
  },
  "preferred_line_length": 88,
  "soft_wrap": "editor_width",
  "toolbar": {
    "code_actions": false,
  },
  "which_key": {
    "enabled": false,
  },
  "terminal": {
    "show_count_badge": true,
  },
  "minimap": {
    "show": "always",
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "project_panel": {
    "hide_hidden": false,
    "scrollbar": {

    },
    "bold_folder_labels": true,
    "auto_reveal_entries": true,
    "folder_indicator": "both",
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "title_tooltip_delay": "default",
    "hide_root": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
  },
  "outline_panel": {
    "multi_buffer_hide_symbols": false,
    "git_status": true,
    "folder_indicator": "both",
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "folder_indicator": "both",
    "collapse_untracked_diff": false,
    "group_by": "staging",
    "status_style": "label_color",
    "show_count_badge": true,
    "entry_primary_click_action": "file_diff",
    "file_icons": true,
    "tree_view": true,
    "dock": "left",
  },
  "format_on_save": "off",
  "show_whitespaces": "boundary",
  "agent": {
    "dock": "right",
    "default_profile": "planner",
    "profiles": {
      "planner": {
        "default_model": {
          "provider": "anthropic",
          "model": "claude-opus-4-5-latest",
        },
        "name": "Planner",
        "tools": {
          "diagnostics": true,
          "read_file": true,
          "thinking": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-latest",
    },
    "model_parameters": [],
  },
  "redact_private_values": true,
  "buffer_font_family": "Fira Code",
  "icon_theme": "Bearded Icon Theme",
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Mocha",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "!pylsp"],
    },
  },
}
