{
    "$schema": "https://opencode.ai/config.json",
    "shell": "/usr/bin/zsh",
    "permission": {
        "external_directory": {
            "~/dev/**": "read"
        },
        "bash": {
            "rtk *": "allow",
            "sed *": "allow",
            "awk *": "allow",
            "grep *": "allow",
            "rg *": "allow",
            "find *": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "wc *": "allow",
            "sort *": "allow",
            "uniq *": "allow",
            "cut *": "allow",
            "tr *": "allow",
            "printf *": "allow",
            "test *": "allow",
            "jq *": "allow",
            "cp *": "allow",
            "mkdir *": "allow",
            "install *": "allow",
            "ps *": "allow",
            "pgrep *": "allow",
            "pkill *": "allow",
            "curl *": "allow",
            "git *": "allow",
            "gh *": "allow",
            "glab *": "allow",
            "pnpm *": "allow",
            "pnpx *": "allow",
            "next *": "allow",
            "cargo *": "allow",
            "rustc *": "allow",
            "rustup *": "allow",
            "go *": "allow",
            "uv *": "allow",
            "make *": "allow",
            "cmake *": "allow",
            "ctest *": "allow",
            "ninja *": "allow",
            "meson *": "allow",
            "just *": "allow",
            "tsc *": "allow",
            "stylelint *": "allow",
            "markdownlint *": "allow",
            "shellcheck *": "allow",
            "podman *": "allow",
            "docker *": "allow",
            "kubectl *": "allow",
            "helm *": "allow",
            "terraform *": "allow"
        }
    }
}

