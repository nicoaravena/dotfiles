{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    //"type": "none",
    //"source": "~/dotfiles/ansi/kirby.ans",
    "padding": {
      "top": 3,
      "left": 2,
    //  "right": 4,
    //  "bottom": 2,
    },
  },
  "display": {
    "separator": " ▶ ",
    "color": {
      "separator": "#5b6078",
      "output": "default",
    },
    "constants": [
      "────────────────────────────────────────────────────────────────",
    ],
    "key": {
      "paddingLeft": 3,
      "type": "both",
    },
  },
  "general": {
    "playerName": "spotify",
  },
  "modules": [
    {
      "type": "colors",
      "paddingLeft": 26,
      "symbol": "diamond",
    },
    {
      "type": "custom",
      "format": "┌{$1}┐",
    },
    {
      "type": "os",
      "key": " OS      ",
      "keyColor": "red",
    },
    {
      "type": "kernel",
      "key": " Kernel  ",
      "keyColor": "red",
    },
    {
      "type": "packages",
      "key": " Packages",
      "keyColor": "red",
    },
    {
      "type": "shell",
      "key": " Shell   ",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": " WM      ",
      "keyColor": "blue",
    },
    {
      "type": "de",
      "key": " DE      ",
      "keyColor": "blue",
    },
    {
      "type": "theme",
      "key": " Theme   ",
      "keyColor": "green",
    },
    {
      "type": "icons",
      "key": " Icons   ",
      "keyColor": "green",
    },
    {
      "type": "terminalfont",
      "key": " Font    ",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": " {$1} ",
    },
    {
      "type": "cpu",
      "key": " CPU     ",
      "keyColor": "magenta",
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}",
    },
    {
      "type": "gpu",
      "key": " GPU     ",
      "keyColor": "magenta",
      "format": "{2}",
      "hideType": "integrated",
    },
    {
      "type": "memory",
      "key": " Memory  ",
      "keyColor": "magenta",
    },
    {
      "type": "display",
      "key": " Display ",
      "keyColor": "bright_magenta",
    },
    {
      "key": " Disk    ",
      "keyColor": "yellow",
      "type": "disk",
      "format": "{?name}{name}{?}{/name}root{/} - {size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "custom",
      "format": " {$1} ",
    },
    {
      "type": "uptime",
      "key": " Uptime  ",
      //"keyColor": "red",
    },
    {
      "key": " Music   ",
      "type": "media",
      "format": "{artist} - {title}",
      "timeout": 1000,
    },
    {
      "type": "custom",
      "format": "└{$1}┘",
    },
    {
      "type": "colors",
      "paddingLeft": 26,
      "symbol": "diamond",
    },
  ],
}
